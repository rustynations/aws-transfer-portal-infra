{
  "name": "aws-transfer-portal-kit",
  "version": "1.0.0",
  "description": "Infrastructure-as-code solution for managed file transfers using AWS Transfer Family with web-based management portal",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:property": "jest --testPathPattern=property",
    "cdk": "npx cdk",
    "deploy": "npm run build && npx cdk deploy",
    "destroy": "npx cdk destroy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com:rustynations/aws-transfer-portal-kit.git"
  },
  "keywords": [
    "aws",
    "cdk",
    "transfer-family",
    "sftp",
    "ftps",
    "file-transfer",
    "infrastructure"
  ],
  "author": "Rusty Nations",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rustynations/aws-transfer-portal-kit/issues"
  },
  "homepage": "https://github.com/rustynations/aws-transfer-portal-kit#readme",
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.989.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.989.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.989.0",
    "@aws-sdk/client-dynamodb": "^3.989.0",
    "@aws-sdk/client-s3": "^3.989.0",
    "@aws-sdk/client-ses": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.989.0",
    "@aws-sdk/util-dynamodb": "^3.989.0",
    "aws-cdk-lib": "2.271.0",
    "constructs": "^10.4.5",
    "js-yaml": "^4.1.1",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.160",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.2.3",
    "aws-cdk": "2.1143.0",
    "fast-check": "^4.5.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
